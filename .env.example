# Copy to .env for local work. Never commit .env. Prod values live only in GitHub
# Environments and `fly secrets`.
MUSICDATA_ENV=local
DATABASE_URL=postgresql://musicdata:musicdata@localhost:5432/musicdata
# DATABASE_URL_READONLY=postgresql://musicdata_ro:...@.../musicdata
API_TOKEN=dev-token-change-me
QUEUE_PAGE_TOKEN=dev-queue-token-change-me

LISTENBRAINZ_USER=MatthewG606
# LISTENBRAINZ_TOKEN=          # only needed for the export API and playing-now
MUSICBRAINZ_USER_AGENT=musicdata/0.1 (https://github.com/<you>/music-data-platform)
# LASTFM_API_KEY=
# TICKETMASTER_API_KEY=
# GOOGLE_ROUTES_API_KEY=       # venue travel times by CTA (ADR 0008): musicdata venues travel
# HOME_ADDRESS=                # where travel times start from; never commit it
# FIRECRAWL_API_KEY=           # graph page fetches; also a dev/prod GitHub Environment secret
# DISCOGS_TOKEN=               # optional: Discogs 60 requests/minute instead of 25
# GRAPH_MONTHLY_CREDITS=100000  # Firecrawl ceiling per calendar month (the plan's limit)
# DOCUMENT_CREDITS=100          # Firecrawl credits per document's page fetches (companion spec 7.1)
# NTFY_TOPIC=                  # e.g. musicdata-<random-suffix>
LOG_JSON=false
